# Canonical origin, no trailing slash.
#
# Must match the host the site actually serves. quicktoolz.tech 301s to the www
# form, so www is canonical — a canonical tag pointing at the bare host would
# name a URL that immediately redirects.
NEXT_PUBLIC_SITE_URL=https://www.quicktoolz.tech

# Google Analytics 4 measurement ID.
# Leave empty to disable analytics entirely, which also stops the privacy
# policy from claiming a cookie the site does not set.
NEXT_PUBLIC_GA_ID=G-NCWT4XME65
